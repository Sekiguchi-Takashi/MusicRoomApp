<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎤 音程チェック"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="声を出すと、いま出ている音の高さを表示します。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/accent_warm"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0.0 Hz   0 cent"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <com.appathy.musicroom.ui.PitchMeterView
            android:id="@+id/meter"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/textVerdict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="待機中"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        style="@style/SectionTitle"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp"
        android:text="音量" />

    <ProgressBar
        android:id="@+id/barLevel"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:max="100" />

    <Button
        android:id="@+id/btnRefTone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="🔊 基準音 A4 (440Hz) を鳴らす" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="ヘッドホンを使うと、スピーカーの音を拾わずに正確に測れます。マイクに息が直接あたらない距離 (20cm ほど) が安定します。"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
